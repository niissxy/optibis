{
  "name": "AssetReview",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "asset_title": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "revision_requested"
      ],
      "default": "revision_requested"
    },
    "quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "quality_details": {
      "type": "object"
    },
    "comments": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    }
  },
  "required": [
    "workspace_id",
    "asset_id",
    "reviewer_id"
  ]
}