{
  "name": "OptimizationAction",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "headline",
        "cta_text",
        "cta_placement",
        "content_structure",
        "metadata",
        "funnel_step",
        "form_field_count",
        "offer_framing",
        "audience_angle",
        "channel_allocation",
        "publishing_timing"
      ]
    },
    "target_entity_id": {
      "type": "string"
    },
    "target_entity_name": {
      "type": "string"
    },
    "current_value": {
      "type": "string"
    },
    "proposed_value": {
      "type": "string"
    },
    "before_metrics": {
      "type": "object"
    },
    "after_metrics": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "proposed",
        "awaiting_approval",
        "active_test",
        "winner",
        "inconclusive",
        "stopped",
        "rolled_back"
      ],
      "default": "detected"
    },
    "sample_size": {
      "type": "number",
      "default": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "owner_id": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "target_type"
  ]
}