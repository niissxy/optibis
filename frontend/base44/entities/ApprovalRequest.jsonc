{
  "name": "ApprovalRequest",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "requested_by_id": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "requested_by_type": {
      "type": "string",
      "enum": [
        "user",
        "ai",
        "automation"
      ],
      "default": "user"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected",
        "revision_requested",
        "expired"
      ],
      "default": "pending"
    },
    "comments": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "entity_type",
    "entity_id",
    "action"
  ]
}