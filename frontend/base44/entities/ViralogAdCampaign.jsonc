{
  "name": "ViralogAdCampaign",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "sponsor_name": {
      "type": "string"
    },
    "banner_url": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "destination_url": {
      "type": "string"
    },
    "placement": {
      "type": "string",
      "enum": [
        "top_leaderboard",
        "after_hero",
        "section_separator",
        "in_feed",
        "sidebar_sticky",
        "short_video_sponsor",
        "long_video_sponsor",
        "article_top",
        "article_middle",
        "article_bottom",
        "rss_separator",
        "category_banner",
        "search_sponsored",
        "footer_ads",
        "mobile_sticky",
        "native_ads"
      ],
      "default": "in_feed"
    },
    "category_slug": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "id"
    },
    "region": {
      "type": "string"
    },
    "device": {
      "type": "string",
      "enum": [
        "all",
        "desktop",
        "mobile"
      ],
      "default": "all"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "impression_limit": {
      "type": "number",
      "default": 0
    },
    "click_limit": {
      "type": "number",
      "default": 0
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "impressions": {
      "type": "number",
      "default": 0
    },
    "clicks": {
      "type": "number",
      "default": 0
    },
    "conversions": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "sponsor_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "rejected"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "sponsor_name",
    "placement"
  ]
}